#cloud-config
autoinstall:
  version: 1

  # Answer every question up front so nothing is asked on screen.
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us
  # Any tz database name, e.g. Asia/Kolkata or Europe/London.
  timezone: Etc/UTC

  identity:
    hostname: homelab
    username: CHANGEME
    # Generate a SHA-512 hash on any Linux box (or Git Bash on Windows):
    #   openssl passwd -6
    # or, with the whois package installed:  mkpasswd -m sha-512
    # Change the password after first login with: passwd
    password: "REPLACE_WITH_YOUR_OWN_HASH"

  ssh:
    install-server: true
    allow-pw: true

  # Plain whole-disk layout, no LVM.
  storage:
    layout:
      name: direct

  # Skip the network wait so a boot with no network still reaches the login prompt.
  late-commands:
    - curtin in-target --target=/target -- systemctl mask systemd-networkd-wait-online.service
    - curtin in-target --target=/target -- systemctl enable ssh

  # "security" (the default) applies security updates during the install
  # when a network is available; "all" also applies regular updates.
  # There is no "none" -- with no network the step is simply skipped.
  updates: security
  shutdown: reboot
