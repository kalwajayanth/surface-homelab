# Emails on a CLEAN shutdown or reboot, so you know it was deliberate.
# This is an email, separate from the healthchecks.io heartbeat: the
# heartbeat only notices the box has gone quiet (~15 min later); this
# mail arrives immediately and says "this was on purpose".
#
# How it works: the unit is started at boot and does nothing. When the
# system shuts down, systemd stops it, and ExecStop sends the mail.
# Ordering it After= the network and DNS means that at shutdown it is
# stopped BEFORE Wi-Fi and the resolver go down, so the mail can leave.
#
# Requires msmtp to be configured. Enable with:
#   sudo systemctl enable --now shutdown-notify.service

[Unit]
Description=Email notice on clean shutdown or reboot
Wants=network-online.target
After=network-online.target nss-lookup.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/homelab/homelab.env
ExecStart=/bin/true
ExecStop=/bin/sh -c 'echo "$$(hostname) is shutting down cleanly at $$(date)" | mail -s "[shutdown] $$(hostname)" "$${ALERT_EMAIL:-root}"'
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
