# Emails on a CLEAN shutdown or reboot, so you know it was deliberate, and
# leaves a marker so boot-notify.service can report the next boot as
# "back up after a clean reboot" rather than "after an unclean shutdown".
# Separate from the healthchecks.io heartbeat, which only notices the box
# has gone quiet (~15 min later).
#
# How it works: the unit is started at boot and does nothing. When the
# system shuts down, systemd stops it, and ExecStop runs the script.
# Ordering it After= the network and DNS means that at shutdown it is
# stopped BEFORE Wi-Fi and the resolver go down, so the mail can leave.
#
# Requires msmtp. Enabled by install/enable-timers.sh.

[Unit]
Description=Email notice on clean shutdown or reboot
Wants=network-online.target
After=network-online.target nss-lookup.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/opt/homelab/scripts/shutdown-notify.sh
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
