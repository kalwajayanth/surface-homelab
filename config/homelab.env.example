# Copy to /etc/homelab/homelab.env on the server and fill in real values.
#   sudo mkdir -p /etc/homelab
#   sudo cp config/homelab.env.example /etc/homelab/homelab.env
#   sudo chmod 600 /etc/homelab/homelab.env
#
# Nothing in this repo should ever contain real values. Keep them here only.

# Where alerts go.
ALERT_EMAIL="you@example.com"

# Wireless interface name. Find yours with:  ip -brief link
WIFI_IFACE="wlp1s0"

# Temperature at which the watcher starts alerting (Celsius).
TEMP_THRESHOLD=75

# Seconds between repeat temperature alerts, so one hot afternoon
# does not fill your inbox. 10800 = 3 hours.
TEMP_COOLDOWN=10800

# Healthchecks.io ping URL for the dead-man's switch.
# Leave empty to disable the heartbeat.
HEARTBEAT_URL=""

# Shown in report footers so you remember how to reach the box.
SSH_HINT="ssh user@192.168.0.0"
